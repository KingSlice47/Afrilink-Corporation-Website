---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaveDivider from '../components/WaveDivider.astro';

const title = 'Strategic Partnerships — Afrilink Corporation';
const description = 'Collaborative relationships with leading institutions driving knowledge sharing, capacity building, and regional development across Africa.';

const partners = [
  {
    monogram: 'UB',
    name: 'University of Botswana',
    type: 'Educational Partnership',
    summary: 'Comprehensive educational technology platform leveraging LMS and ECM solutions to deliver digital transformation for higher education delivery.',
    details: 'Development and implementation of a robust, scalable learning management system tailored to the university\'s academic standards and regulatory requirements. Scope includes infrastructure assessments, interactive course materials, faculty training programs, and ongoing technical support.',
  },
  {
    monogram: 'ELO',
    name: 'ELO Digital Office',
    type: 'Technology Partnership',
    summary: 'Strategic alliance with a leading German software company specializing in intelligent document management and digital process automation.',
    details: 'Access to scalable Enterprise Content Management (ECM) solutions serving over 1.3 million users globally. Seamless integration with Microsoft, SAP, and Salesforce ensures compatibility with existing IT infrastructure.',
  },
];

const benefits = [
  { title: 'Knowledge Transfer',    body: 'Access to cutting-edge technologies, best practices, and international expertise that enhance our capabilities and competitive positioning.' },
  { title: 'Market Expansion',      body: 'Collaborative opportunities that open new markets and create pathways for growth across the African continent and beyond.' },
  { title: 'Capacity Building',     body: 'Skills development and training programs that enhance human capital across our organization and portfolio companies.' },
  { title: 'Innovation Leadership', body: 'Access to emerging technologies and innovative solutions that position us at the forefront of digital transformation in Africa.' },
];
---

<BaseLayout title={title} description={description}>
  <section class="page-header-wave">
    <div class="container">
      <span class="section-eyebrow">Strategic Partnerships</span>
      <h1>Partnerships &amp; Affiliations</h1>
      <p>Collaborative relationships with leading institutions driving knowledge sharing, capacity building, and regional development across Africa.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="overview-heading">
    <div class="container narrow">
      <h2 id="overview-heading">Partnership Philosophy</h2>
      <p>
        Afrilink Corporation recognizes that sustainable business growth and meaningful economic
        transformation require collaborative relationships with leading institutions across Africa.
        Our strategic partnerships reflect our commitment to knowledge sharing, capacity building,
        and regional development through alliances with respected academic and business organizations.
      </p>
    </div>
  </section>

  <WaveDivider fillColor="#F8F9FB" direction="down" intensity="subtle" tint="orange" />

  <section class="section section--alt" aria-labelledby="partners-heading">
    <div class="container">
      <h2 id="partners-heading">Our Strategic Partners</h2>

      <div class="partner-grid">
        {partners.map(p => (
          <article class="partner-card">
            <div class="partner-card__logo" aria-hidden="true">{p.monogram}</div>
            <div class="partner-card__body">
              <span class="partner-card__type">{p.type}</span>
              <h3>{p.name}</h3>
              <p>{p.summary}</p>
              <p class="partner-card__details">{p.details}</p>
            </div>
          </article>
        ))}

        <article class="partner-card partner-card--cta">
          <div class="partner-card__logo partner-card__logo--cta" aria-hidden="true">+</div>
          <div class="partner-card__body">
            <span class="partner-card__type">Growing Network</span>
            <h3>Future Partnerships</h3>
            <p>
              We are actively seeking strategic partnerships with organizations that share
              our commitment to economic empowerment and sustainable growth across Africa.
            </p>
            <a href="#inquiry" class="btn btn-primary btn--sm">Partner With Us</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <WaveDivider fillColor="#FFFFFF" direction="up" intensity="subtle" tint="grey" />

  <section class="section" aria-labelledby="benefits-heading">
    <div class="container">
      <span class="section-eyebrow">Why Partner With Us</span>
      <h2 id="benefits-heading">Partnership Benefits</h2>
      <p class="section-lead">
        Our strategic partnerships deliver measurable value across multiple dimensions of our business operations.
      </p>
      <div class="benefit-grid">
        {benefits.map((b, i) => (
          <article class="benefit-card">
            <span class="benefit-card__index">0{i + 1}</span>
            <h3>{b.title}</h3>
            <p>{b.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <WaveDivider fillColor="#F8F9FB" direction="down" intensity="subtle" tint="orange" />

  <section class="section section--alt" id="inquiry" aria-labelledby="inquiry-heading">
    <div class="container narrow">
      <span class="section-eyebrow">Get In Touch</span>
      <h2 id="inquiry-heading">Partnership Opportunities</h2>
      <p class="section-lead">
        Interested in exploring partnership opportunities with Afrilink Corporation?
        We welcome discussions with organizations that share our commitment to economic empowerment and sustainable growth.
      </p>

      <form class="inquiry-form" action="#" method="post" novalidate>
        <div class="form-row">
          <div class="form-group">
            <label for="organization-name">Organization Name <span aria-label="required">*</span></label>
            <input type="text" id="organization-name" name="organization-name" required />
          </div>
          <div class="form-group">
            <label for="contact-person">Contact Person <span aria-label="required">*</span></label>
            <input type="text" id="contact-person" name="contact-person" required />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="email">Email Address <span aria-label="required">*</span></label>
            <input type="email" id="email" name="email" required />
          </div>
          <div class="form-group">
            <label for="phone">Phone Number</label>
            <input type="tel" id="phone" name="phone" />
          </div>
        </div>
        <div class="form-group">
          <label for="partnership-type">Partnership Interest</label>
          <select id="partnership-type" name="partnership-type">
            <option value="">Select partnership type</option>
            <option value="technology">Technology Partnership</option>
            <option value="education">Educational Collaboration</option>
            <option value="investment">Investment Opportunity</option>
            <option value="strategic">Strategic Alliance</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="form-group">
          <label for="message">Partnership Proposal <span aria-label="required">*</span></label>
          <textarea id="message" name="message" rows="6" required
            placeholder="Please describe your partnership proposal and how it aligns with our mission of economic empowerment and sustainable growth."></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Submit Partnership Inquiry</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .container.narrow { max-width: 880px; }

  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--c-orange);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: var(--s-sm);
  }
  .section-eyebrow::before {
    content: "";
    width: 28px;
    height: 2px;
    background: var(--c-orange);
  }
  .section-lead {
    font-size: 1.0625rem;
    color: var(--t-secondary);
    max-width: 65ch;
    margin: var(--s-sm) 0 var(--s-xl);
  }

  .partner-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--s-md);
    margin-top: var(--s-md);
  }
  .partner-card {
    background: var(--c-white);
    border-radius: var(--r-sm);
    padding: var(--s-lg);
    box-shadow: var(--shadow-md);
    border-top: 3px solid var(--c-orange);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }
  .partner-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }
  .partner-card__logo {
    width: 72px;
    height: 72px;
    background: linear-gradient(135deg, var(--c-navy) 0%, var(--c-navy-light) 100%);
    color: var(--c-orange-lt);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-sm);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: var(--s-md);
  }
  .partner-card__logo--cta {
    background: linear-gradient(135deg, var(--c-orange) 0%, var(--c-gold) 100%);
    color: var(--c-white);
    font-size: 2rem;
  }
  .partner-card__type {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-orange);
    margin-bottom: 4px;
    display: inline-block;
  }
  .partner-card h3 {
    font-size: 1.25rem;
    margin-bottom: var(--s-xs);
  }
  .partner-card p { font-size: 0.9375rem; margin-bottom: var(--s-sm); }
  .partner-card__details {
    font-size: 0.875rem;
    color: var(--t-muted);
    padding-top: var(--s-sm);
    border-top: 1px solid var(--c-grey-200);
  }
  .partner-card--cta { background: var(--c-grey-50); }
  .btn--sm { padding: 0.65rem 1.25rem; font-size: 0.875rem; min-height: 40px; }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--s-md);
  }
  .benefit-card {
    background: var(--c-white);
    padding: var(--s-lg);
    border-radius: var(--r-sm);
    box-shadow: var(--shadow-sm);
    border-left: 3px solid var(--c-orange);
    position: relative;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }
  .benefit-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
  }
  .benefit-card__index {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--c-orange);
  }
  .benefit-card h3 { font-size: 1.0625rem; margin-bottom: 0.5rem; }
  .benefit-card p  { font-size: 0.9375rem; }

  /* Form (shared style) */
  .inquiry-form { display: grid; gap: var(--s-md); margin-top: var(--s-md); }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-md); }
  .form-group { display: grid; gap: 6px; }
  .form-group label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--t-primary);
  }
  .form-group input,
  .form-group select,
  .form-group textarea {
    font-family: inherit;
    font-size: 0.9375rem;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--c-grey-300);
    border-radius: var(--r-sm);
    background: var(--c-white);
    transition: border-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
    min-height: 48px;
  }
  .form-group textarea { min-height: 140px; resize: vertical; }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--c-orange);
    box-shadow: 0 0 0 3px rgba(243, 113, 33, 0.18);
  }
  @media (max-width: 640px) { .form-row { grid-template-columns: 1fr; } }
</style>
