---
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Company',
    links: [
      { href: '/about',                            label: 'About Us' },
      { href: '/about#leadership',                 label: 'Leadership' },
      { href: '/about#mission-vision',             label: 'Mission & Vision' },
      { href: '/about#values',                     label: 'Corporate Values' },
    ],
  },
  {
    title: 'Portfolio',
    links: [
      { href: '/portfolio',                        label: 'Investment Holdings' },
      { href: '/portfolio#companies',              label: 'Our Companies' },
      { href: '/#focus',                           label: 'Focus Areas' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { href: '/partnerships',                     label: 'Strategic Partnerships' },
      { href: '/contact',                          label: 'Contact Us' },
      { href: 'mailto:molefe@afrilinkcorp.co.za',  label: 'Email Us' },
    ],
  },
];

const socials = [
  { label: 'LinkedIn',  href: '#', svg: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z' },
  { label: 'X / Twitter', href: '#', svg: 'M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z' },
  { label: 'Facebook',  href: '#', svg: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z' },
  { label: 'YouTube',   href: '#', svg: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z' },
];
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="/afrilink-logo.png" alt="Afrilink Corporation" class="footer-brand__logo" />
        <p class="footer-brand__tag">Empowering Growth, Creating Value, Building Futures</p>
        <p class="footer-brand__reg"><strong>Registration:</strong> 2018/440447/07</p>
      </div>

      {columns.map(col => (
        <div class="footer-col">
          <h4>{col.title}</h4>
          <ul>
            {col.links.map(l => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
      ))}

      <div class="footer-col">
        <h4>Connect</h4>
        <div class="socials">
          {socials.map(s => (
            <a href={s.href} class="social" aria-label={s.label}>
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d={s.svg}></path>
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} Afrilink Corporation (Pty) Ltd. All rights reserved.</p>
      <nav class="footer-legal" aria-label="Legal">
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Use</a>
      </nav>
      <p class="footer-credit">Site developed by <strong>Afrilink Telecoms (Pty) Ltd</strong></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-navy);
    color: var(--t-inverse-dim);
    padding: var(--s-xl) 0 var(--s-sm);
    margin-top: 0;
    position: relative;
  }
  .site-footer::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--c-orange) 0%, var(--c-gold) 50%, var(--c-wave-2) 100%);
    opacity: 0.6;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(4, 1fr);
    gap: var(--s-lg);
    padding-bottom: var(--s-lg);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-brand__logo { width: 48px; height: 48px; margin-bottom: 0.5rem; object-fit: contain; }
  .footer-brand__tag {
    color: var(--c-white);
    font-weight: 600;
    margin-bottom: var(--s-xs);
    max-width: 30ch;
  }
  .footer-brand__reg { font-size: 0.875rem; color: var(--t-inverse-dim); }

  .footer-col h4 {
    color: var(--c-white);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 0.5rem;
  }
  .footer-col ul { display: flex; flex-direction: column; gap: 0.35rem; }
  .footer-col a {
    color: var(--t-inverse-dim);
    font-size: 0.9375rem;
    transition: color 0.2s var(--ease-out);
  }
  .footer-col a:hover { color: var(--c-orange-lt); }

  .socials { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .social {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.06);
    border-radius: var(--r-sm);
    transition: background 0.2s var(--ease-out), transform 0.2s var(--ease-out);
  }
  .social svg { width: 18px; height: 18px; fill: var(--c-white); }
  .social:hover { background: var(--c-orange); transform: translateY(-2px); }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem var(--s-md);
    padding-top: var(--s-sm);
    font-size: 0.8125rem;
  }
  .footer-legal { display: flex; gap: var(--s-md); }
  .footer-legal a { color: var(--t-inverse-dim); }
  .footer-legal a:hover { color: var(--c-orange-lt); }
  .footer-credit {
    color: var(--t-inverse-dim);
    font-size: 0.8125rem;
    margin: 0;
  }
  .footer-credit strong { color: var(--c-orange-lt); font-weight: 600; }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: var(--s-lg); }
  }
  @media (max-width: 540px) {
    .footer-grid { grid-template-columns: 1fr; }
    .footer-bottom { flex-direction: column; text-align: center; }
  }
</style>
