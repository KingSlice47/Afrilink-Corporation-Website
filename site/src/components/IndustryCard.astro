---
export interface Props {
  name: string;
  sector: string;
  description: string;
  /** Industry slug — maps to /assets/images/industries/{slug}.jpg */
  imageSlug: string;
  /** Optional logo to show as monogram if image not yet available */
  monogram?: string;
}

const { name, sector, description, imageSlug, monogram } = Astro.props;
const imageSrc = `/industries/${imageSlug}.jpg`;
---

<article class="industry-card">
  <div class="industry-card__media">
    <!-- Duotone-treated image; degrades to monogram if image missing -->
    <img
      src={imageSrc}
      alt={`${name} — ${sector}`}
      class="industry-card__img"
      loading="lazy"
      decoding="async"
      onerror="this.style.display='none'; this.nextElementSibling?.classList.add('is-shown');"
    />
    <div class={`industry-card__fallback ${!monogram ? '' : ''}`} aria-hidden="true">
      <span>{monogram ?? name.charAt(0)}</span>
    </div>
    <div class="industry-card__duotone" aria-hidden="true"></div>
    <span class="industry-card__sector">{sector}</span>
  </div>
  <div class="industry-card__body">
    <h3>{name}</h3>
    <p>{description}</p>
  </div>
</article>

<style>
  .industry-card {
    background: var(--c-white);
    border-radius: var(--r-sm);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
    display: flex;
    flex-direction: column;
    height: 100%;
    border-bottom: 3px solid transparent;
  }
  .industry-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
    border-bottom-color: var(--c-orange);
  }
  .industry-card:hover .industry-card__img { transform: scale(1.06); }
  .industry-card:hover .industry-card__duotone { opacity: 0.55; }

  .industry-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, var(--c-navy) 0%, var(--c-navy-light) 100%);
    overflow: hidden;
  }
  .industry-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
    /* Base photo treatment */
    filter: grayscale(35%) contrast(1.05) brightness(0.92);
  }

  /* Duotone wash — sits over the image */
  .industry-card__duotone {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, rgba(4, 9, 34, 0.85) 0%, rgba(243, 113, 33, 0.45) 100%);
    mix-blend-mode: multiply;
    opacity: 0.75;
    transition: opacity 0.4s var(--ease-out);
    pointer-events: none;
  }

  /* Fallback shown when image fails to load */
  .industry-card__fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--c-orange-lt);
    font-size: 4rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    background: linear-gradient(135deg, var(--c-navy) 0%, var(--c-navy-light) 100%);
    z-index: 0;
  }
  .industry-card__fallback.is-shown { z-index: 1; }

  .industry-card__sector {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;
    background: rgba(4, 9, 34, 0.85);
    color: var(--c-white);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.4rem 0.75rem;
    border-radius: var(--r-sm);
    border-left: 2px solid var(--c-orange);
    backdrop-filter: blur(8px);
  }

  .industry-card__body {
    padding: var(--s-md) var(--s-md) var(--s-lg);
    flex: 1;
  }
  .industry-card__body h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--t-primary);
  }
  .industry-card__body p {
    font-size: 0.9375rem;
    color: var(--t-secondary);
    line-height: 1.55;
  }
</style>
