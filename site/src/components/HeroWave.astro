---
export interface Props {
  eyebrow?: string;
  titleStart: string;
  titleAccent: string;
  titleEnd?: string;
  description: string;
  primaryCta: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
}

const {
  eyebrow = 'Afrilink Corporation',
  titleStart,
  titleAccent,
  titleEnd = '',
  description,
  primaryCta,
  secondaryCta,
} = Astro.props;
---

<section class="hero-wave" aria-labelledby="hero-heading">
  <!-- Ambient floating particles -->
  <div class="hero-particles" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span><span></span>
  </div>

  <!-- Diagonal accent streaks sweeping across -->
  <div class="hero-streak hero-streak--1" aria-hidden="true"></div>
  <div class="hero-streak hero-streak--2" aria-hidden="true"></div>
  <div class="hero-streak hero-streak--3" aria-hidden="true"></div>

  <!-- Subtle animated wave layers — bottom of hero -->
  <svg
    class="hero-wave__svg"
    viewBox="0 0 1440 320"
    preserveAspectRatio="none"
    aria-hidden="true"
    role="presentation"
  >
    <defs>
      <linearGradient id="wave-grad-1" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%"   stop-color="#1E3A8A" stop-opacity="0.0" />
        <stop offset="50%"  stop-color="#3B82F6" stop-opacity="0.85" />
        <stop offset="100%" stop-color="#1E3A8A" stop-opacity="0.0" />
      </linearGradient>
      <linearGradient id="wave-grad-2" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%"   stop-color="#F37121" stop-opacity="0.0" />
        <stop offset="50%"  stop-color="#F37121" stop-opacity="0.9" />
        <stop offset="100%" stop-color="#FFD177" stop-opacity="0.0" />
      </linearGradient>
      <linearGradient id="wave-grad-3" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%"  stop-color="#040922" stop-opacity="0.95" />
        <stop offset="100%" stop-color="#0A1235" stop-opacity="1" />
      </linearGradient>
    </defs>

    <!-- Subtle layer 1: deep blue wash -->
    <path
      class="hero-wave__path hero-wave__path--1"
      fill="url(#wave-grad-1)"
      d="M0,180 C240,140 480,260 720,200 C960,140 1200,240 1440,180 L1440,320 L0,320 Z"
    />
    <!-- Subtle layer 2: orange accent ribbon -->
    <path
      class="hero-wave__path hero-wave__path--2"
      fill="none"
      stroke="url(#wave-grad-2)"
      stroke-width="2"
      d="M0,210 C300,160 600,260 900,200 C1200,150 1320,220 1440,200"
    />
    <!-- Foreground: solid navy fill to ground the hero -->
    <path
      class="hero-wave__path hero-wave__path--3"
      fill="url(#wave-grad-3)"
      d="M0,240 C200,210 480,290 720,250 C960,210 1200,280 1440,240 L1440,320 L0,320 Z"
    />
  </svg>

  <div class="hero-wave__inner">
    <div>
      <span class="hero-wave__eyebrow">{eyebrow}</span>
      <h1 id="hero-heading" class="hero-wave__title">
        {titleStart}{' '}<em>{titleAccent}</em>{titleEnd && <> {titleEnd}</>}
      </h1>
      <p class="hero-wave__desc">{description}</p>
      <div class="hero-wave__cta">
        <a href={primaryCta.href} class="btn btn-primary">{primaryCta.label}</a>
        {secondaryCta && (
          <a href={secondaryCta.href} class="btn btn-outline--light btn-outline">{secondaryCta.label}</a>
        )}
      </div>
    </div>

    <div class="hero-wave__visual" aria-hidden="true">
      <!-- Pulse rings emanating from the center -->
      <span class="hero-pulse"></span>
      <span class="hero-pulse hero-pulse--2"></span>
      <span class="hero-pulse hero-pulse--3"></span>

      <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="ring-grad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%"   stop-color="#F37121" />
            <stop offset="100%" stop-color="#FFD177" />
          </linearGradient>
          <linearGradient id="ring-grad-2" x1="1" y1="0" x2="0" y2="1">
            <stop offset="0%"   stop-color="#3B82F6" />
            <stop offset="100%" stop-color="#1E3A8A" />
          </linearGradient>
        </defs>

        <!-- Concentric sweeping arcs (sped up ~2x) -->
        <circle cx="200" cy="200" r="170"
                fill="none" stroke="url(#ring-grad)" stroke-width="1.5"
                stroke-dasharray="900 2000" opacity="0.55">
          <animateTransform attributeName="transform" type="rotate"
                            from="0 200 200" to="360 200 200" dur="28s" repeatCount="indefinite" />
        </circle>
        <circle cx="200" cy="200" r="130"
                fill="none" stroke="url(#ring-grad-2)" stroke-width="1.5"
                stroke-dasharray="600 1500" opacity="0.45">
          <animateTransform attributeName="transform" type="rotate"
                            from="360 200 200" to="0 200 200" dur="22s" repeatCount="indefinite" />
        </circle>
        <circle cx="200" cy="200" r="90"
                fill="none" stroke="url(#ring-grad)" stroke-width="1.25"
                stroke-dasharray="400 1000" opacity="0.65">
          <animateTransform attributeName="transform" type="rotate"
                            from="0 200 200" to="360 200 200" dur="16s" repeatCount="indefinite" />
        </circle>

        <!-- Small orbiting dot on the outer ring -->
        <circle cx="200" cy="30" r="5" fill="#FFD177" opacity="0.95">
          <animateTransform attributeName="transform" type="rotate"
                            from="0 200 200" to="360 200 200" dur="8s" repeatCount="indefinite" />
        </circle>
        <!-- Counter-rotating dot on the middle ring -->
        <circle cx="200" cy="70" r="4" fill="#3B82F6" opacity="0.9">
          <animateTransform attributeName="transform" type="rotate"
                            from="360 200 200" to="0 200 200" dur="6s" repeatCount="indefinite" />
        </circle>

        <!-- Central glow with pulsing animation -->
        <circle cx="200" cy="200" r="48" fill="url(#ring-grad)" opacity="0.95">
          <animate attributeName="r" values="46;52;46" dur="3.2s" repeatCount="indefinite" />
        </circle>
        <circle cx="200" cy="200" r="48" fill="none" stroke="#FFFFFF" stroke-width="1" opacity="0.4">
          <animate attributeName="r" values="48;56;48" dur="3.2s" repeatCount="indefinite" />
          <animate attributeName="opacity" values="0.4;0.1;0.4" dur="3.2s" repeatCount="indefinite" />
        </circle>
      </svg>
    </div>
  </div>
</section>
